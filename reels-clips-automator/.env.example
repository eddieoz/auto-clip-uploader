# AI API Key (for LLM calls - OpenAI, Nous, or any OpenAI-compatible endpoint)
OPENAI_API_KEY='your-api-key-here'

# AI Endpoint (OpenAI-compatible API URL - e.g., Nous API, local server)
# Leave empty for default OpenAI endpoint
AI_ENDPOINT='https://api.nousresearch.com/v1'

CHANNEL_NAME="your-channel-name"

# STT (Speech-to-Text) Model Configuration
# Choose between "whisper" (default) or "faster-whisper"
STT_MODEL="whisper"

# Whisper model configuration (when using STT_MODEL="whisper")
WHISPER_MODEL="small"

# Faster Whisper Configuration (when using STT_MODEL="faster-whisper")
# Model size: tiny, base, small, medium, large
FASTER_WHISPER_MODEL_SIZE="small"
# Device: auto, cpu, cuda
FASTER_WHISPER_DEVICE="auto"
# Compute type: default, int8, float16
FASTER_WHISPER_COMPUTE_TYPE="default"

# OpenAI model configuration
OPENAI_MODEL="your-model"

# Language Configuration for Transcription
# Leave empty or comment out for automatic language detection
# Use language codes like: 'pt' (Portuguese), 'en' (English), 'es' (Spanish), 'fr' (French), etc.
# TRANSCRIPTION_LANGUAGE="pt"
# --- Video editing pipeline (reelsfy) ---------------------------------------
# Every feature below is env-gated; defaults match the feat/improve-video
# behavior. Commented lines show the defaults.

# Topic boundary LLM pass: trims the previous topic's tail from the clip start
# and proposes hook candidates for the cold-open teaser. "false" reverts to the
# heuristic-only legacy behavior.
# TOPIC_BOUNDARY_LLM="true"

# Jump cuts: remove intra-segment dead air (pauses longer than the threshold,
# in seconds) and remap caption timings.
# JUMP_CUTS_ENABLED="true"
# JUMP_CUT_PAUSE_THRESHOLD="0.6"

# Karaoke captions: font family and per-word highlight color (ASS format
# &HAABBGGRR - this value is yellow).
# CAPTION_FONT_FAMILY="Noto Sans"
# CAPTION_HIGHLIGHT_COLOR="&H0000FFFF"

# Framing for screencast sources (face in the top third): auto (detect layout),
# pip (circular face-cam badge over the screen), screen_zoom (motion-following
# zoom), closeup (whole-clip face close-up).
# FRAMING_MODE="auto"

# Visual grade: mild saturation/contrast lift + light sharpen on the final clip.
# VIDEO_GRADE="true"
# Optional .cube LUT applied on top of the grade.
# VIDEO_LUT="/path/to/lut.cube"

# End card: 1.5 s CTA appended at assembly with a fade-in. Default ON.
# It was default OFF only as an interim mitigation for an assembly freeze
# that has since been fixed at the source: the end card was the one piece
# that never declared a frame rate, so `concat -c copy` collapsed it into
# 2.5 ms on the main clip's last frames. Set to "false" to opt out.
# END_CARD_ENABLED="false"
# END_CARD_TEXT="Segue para mais!"
# END_CARD_COLOR="0x14213D"

# Music bed: audio file looped under the speech at -24 dB and mastered with it.
# Empty = no music bed.
# MUSIC_BED="/path/to/music.mp3"
